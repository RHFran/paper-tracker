{
  "workflow": {
    "mode": "agent"
  },
  "agent": {
    "backend": "codex",
    "model": "",
    "reasoning_effort": "",
    "timeout_seconds": 1800
  },
  "recipient": "researcher@example.org",
  "timezone": "UTC",
  "language": "en",
  "topics": [
    {
      "id": "forest-carbon",
      "name": "Forest carbon and climate",
      "queries": [
        "forest carbon flux climate",
        "forest carbon drought"
      ],
      "include_any": [
        "forest",
        "carbon"
      ],
      "include_all": [],
      "exclude_any": [
        "fossil fuel"
      ]
    },
    {
      "id": "remote-sensing",
      "name": "Tree species mapping",
      "queries": [
        "tree species mapping hyperspectral",
        "tree species classification lidar"
      ],
      "include_any": [
        "tree species",
        "forest species"
      ],
      "include_all": [],
      "exclude_any": []
    }
  ],
  "schedule": {
    "time": "08:30",
    "weekdays": [
      0,
      1,
      2,
      3,
      4,
      5,
      6
    ],
    "catch_up": true
  },
  "publication_window_days": 7,
  "state_path": "state/digest.sqlite3",
  "output_dir": "output",
  "contact_email": "",
  "sources": [
    "crossref",
    "europepmc"
  ],
  "page_size": 100,
  "max_pages_per_query": 20,
  "http_timeout_seconds": 45,
  "http_retries": 3,
  "fetch_full_text": false,
  "include_preprints": true,
  "max_papers_per_track": 10,
  "images": {
    "mode": "embed",
    "max_per_paper": 3
  },
  "figure_catalog": {},
  "llm": {
    "enabled": false,
    "base_url_env": "LITERATURE_LLM_BASE_URL",
    "api_key_env": "LITERATURE_LLM_API_KEY",
    "model_env": "LITERATURE_LLM_MODEL",
    "max_evidence_chars": 60000
  },
  "mail": {
    "enabled": false,
    "host_env": "LITERATURE_SMTP_HOST",
    "port": 465,
    "security": "ssl",
    "user_env": "LITERATURE_SMTP_USER",
    "password_env": "LITERATURE_SMTP_PASSWORD",
    "from_env": "LITERATURE_MAIL_FROM"
  }
}
