  author = {{A. Example (simulated author)} and {B. Example (simulated author)}},
  journal = {DEMO Synthetic Research (not a real journal)},
  year = {2026},
  date = {2026-10-01},
  url = {https://example.org/demo/canopy-species},
  abstract = {DEMO / SYNTHETIC SOURCE. All studies, authors, observations, and results below are invented for an offline layout preview. The synthetic mapping workflow integrates seasonal spectral and canopy-height observations for tree-species discrimination. We ask whether seasonal spectral and canopy-height information improve tree-species discrimination. A random-forest classifier combined two-season hyperspectral imagery with lidar canopy-height features. The synthetic dataset contains 120 four-species plots; training and evaluation use spatially separate stands. The comparison covers one simulated site; transfer to other forests, sensors, and rare species remains untested. Simulated held-out macro-F1 was 0.82 for spectral-plus-height features and 0.74 for the single-season spectral baseline.},
  note = {DEMO / SYNTHETIC: invented offline fixture; not a real publication.; Synthetic demo; not published or peer reviewed; Date source: Fixed fixture date; not a publication record},
