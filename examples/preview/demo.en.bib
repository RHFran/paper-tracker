@misc{paper_e56128e634f801863f8b,
  title = {[DEMO / SYNTHETIC] Drought intensity and species-specific canopy volatile emissions},
  author = {{A. Example (simulated author)} and {B. Example (simulated author)}},
  journal = {DEMO Synthetic Research (not a real journal)},
  year = {2026},
  date = {2026-10-01},
  url = {https://example.org/demo/forest-bvoc},
  abstract = {DEMO / SYNTHETIC SOURCE. All studies, authors, observations, and results below are invented for an offline layout preview. The synthetic design evaluates species-specific emission responses rather than assuming a uniform drought effect. We ask how drought intensity changes volatile emissions across tree species. Repeated branch-chamber sampling and gas chromatography were analyzed using species-by-treatment mixed-effects models. The simulated experiment followed 72 saplings from three tree species through two controlled drought cycles. The controlled sapling experiment did not test mature forests or seasonal variation under field conditions. Moderate drought increased isoprene emissions in one species but not the other two in the simulated observations. Severe drought reduced emissions in all three simulated species relative to their watered controls.},
