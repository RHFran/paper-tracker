# Copy to a private file outside version control. Use provider-issued values.
# This file is not loaded automatically by the Python CLI.
# CLI: paper-tracker --env-file .env validate; wrappers accept the same flag.
# Never shell-source the wizard-produced file; use the application loader.
# Literal KEY=value data only; quotes are optional; no shell expansion.
# configure-model writes profile-specific PAPER_TRACKER_<SLOT>_* entries.
# Model: an HTTPS OpenAI-compatible base URL, ending in /v1 when required.
LITERATURE_LLM_BASE_URL=
LITERATURE_LLM_API_KEY=
LITERATURE_LLM_MODEL=
# SMTP: the host, account, password/app-password and authorized sender.
# Enable mail in your JSON config only after reviewing a dry-run report.
LITERATURE_SMTP_HOST=
LITERATURE_SMTP_USER=
LITERATURE_SMTP_PASSWORD=
LITERATURE_MAIL_FROM=
